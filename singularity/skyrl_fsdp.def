Bootstrap: docker
From: pytorch/pytorch:2.11.0-cuda12.8-cudnn9-devel

%labels
    description "SkyRL FSDP training environment: PyTorch 2.11 + CUDA 12.8 + vLLM 0.20.2"

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export TOKENIZERS_PARALLELISM=false
    export HF_HUB_ENABLE_HF_TRANSFER=1
    export OMP_NUM_THREADS=4

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export PIP_NO_CACHE_DIR=0
    export PIP_CACHE_DIR=/tmp/pip_cache

    # Basic tools
    apt-get update -qq && apt-get install -y --no-install-recommends \
        curl git wget unzip build-essential \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # uv
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.cargo/bin:$PATH"

    PIP="pip install --no-cache-dir --break-system-packages"

    # Install vllm cu129 wheel (CUDA 12.9 = libcudart.so.12, compatible with CUDA 12.8 base)
    $PIP "https://github.com/vllm-project/vllm/releases/download/v0.20.2/vllm-0.20.2+cu129-cp38-abi3-manylinux_2_31_x86_64.whl"

    # Install flash-attn pre-built wheel for torch 2.11
    $PIP "https://github.com/erictang000/flash-attention/releases/download/v2.8.3-torch2.11-clean/flash_attn-2.8.3-cp312-cp312-linux_x86_64.whl" \
        || $PIP flash-attn==2.8.3 --no-build-isolation

    # Install remaining SkyRL fsdp deps (excluding torch/vllm already installed)
    $PIP \
        ray==2.51.1 \
        accelerate \
        loguru tqdm ninja tensorboard func_timeout \
        "hydra-core==1.3.2" \
        omegaconf \
        peft "debugpy==1.8.0" hf_transfer wandb \
        datasets tensordict jaxtyping \
        polars s3fs fastapi uvicorn \
        vllm-router \
        nixl \
        torchvision \
        torchdata

    # Install skyrl and skyrl-gym in editable mode from bind-mounted project
    # (done at runtime via --bind, so just record the path for reference)

    # Clean pip cache
    rm -rf /tmp/pip_cache

%runscript
    exec "$@"
